# Supabase 새 API 키 형식 사용 (sb_publishable_* / sb_secret_*)
# 기존 anon/service_role JWT 형식은 deprecated 경로.

# ── Frontend (Vite는 VITE_ prefix만 노출) ──
# Publishable key는 RLS로 보호되는 공개 키. 노출 OK.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (functions/api/) ──
# 절대 src/ 에 import 금지. Cloudflare Pages → Settings → Variables and Secrets
# 에 Type=Secret 으로 등록. 로컬 테스트는 .dev.vars (gitignore됨) 사용.

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI (Day 3 저녁 PoC 부터 사용)
OPENAI_API_KEY=

# Polar.sh (Sprint 3 결제부터 사용)
POLAR_SECRET=
POLAR_WEBHOOK_SECRET=

# Cloudflare Browser Rendering (도매처 크롤링 — Sprint 2)
CF_BROWSER_RENDERING_TOKEN=
